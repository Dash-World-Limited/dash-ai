# Dash AI API — STAGING configuration template.
#
# This file is safe to commit: it contains no secrets and no real hostnames. Copy the
# non-secret values into your platform's environment settings. Secrets marked below must come from
# a secret manager and must never be written into this file, a commit, a ticket or a chat.
# See docs/staging-runbook.md.

# --- Values safe to commit (staging defaults) -----------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Real providers. OpenAI/Anthropic need key + model. Bedrock needs key + region + at least one
# BEDROCK_MODEL_* value. Production refuses incomplete/placeholder live configuration.
PROVIDER_MODE=live
# Consumers never see which AI provider or model answered (DASH AI is the product).
PROVIDER_DETAILS=hidden
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Leave false until the live smoke test passes for your OpenAI model.
OPENAI_ENCRYPTED_REASONING=false

# Amazon Bedrock non-secret settings. Use the Ireland region for the DASH production stack unless
# deployment architecture changes. Model ids are supplied deliberately after access is confirmed.
# A Region on its own does not switch Bedrock on. iam = AWS credentials (recommended for production);
# api_key = BEDROCK_API_KEY below.
BEDROCK_AUTH=iam
BEDROCK_REGION=eu-west-1
BEDROCK_MODEL_MICRO=
BEDROCK_MODEL_LITE=
BEDROCK_MODEL_NOVA2_LITE=

# Optional USD price overrides for the internal cost estimate (see apps/api/.env.example).
MODEL_PRICES=

PROVIDER_TIMEOUT_MS=120000
PROVIDER_IDLE_TIMEOUT_MS=45000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
MAX_OUTPUT_TOKENS=16000
FAKE_STREAM_DELAY_MS=25
DOCUMENT_EXTRACTION_TIMEOUT_MS=20000

RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_ACCOUNT=20
MAX_CONCURRENT_STREAMS_PER_USER=3
# Shared limits across instances (required with more than one API instance).
RATE_LIMIT_BACKEND=redis

SESSION_TTL_DAYS=30
# The API runs behind an HTTPS reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=true

# PostgreSQL over verified TLS. Migrations are a deliberate deployment step.
DATABASE_SSL=require
DATABASE_POOL_MAX=10
DATABASE_AUTO_MIGRATE=false
DATA_ENCRYPTION_KEY_ID=k1
ALLOW_MEMORY_STORE=false

TOOLS_ENABLED=true
TOOL_TIMEOUT_MS=10000
TOOL_MAX_ROUNDS=4
TOOL_MAX_RESULT_CHARS=20000

# --- SECRETS: set in the secret manager, never here ------------------------------------------
# SECRET: postgres://USER:PASSWORD@HOST:5432/DB (TLS is enforced by DATABASE_SSL=require)
DATABASE_URL=
# SECRET: base64 of 32 random bytes: openssl rand -base64 32. Back it up separately.
DATA_ENCRYPTION_KEY=
# SECRET (only after a key rotation): old_id:base64,...
DATA_ENCRYPTION_PREVIOUS_KEYS=
# SECRET: rediss://:PASSWORD@HOST:6380 (TLS) for the shared rate limiter
REDIS_URL=
# SECRET: provider API keys. Bedrock should use short-lived credentials/keys where possible.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Only with BEDROCK_AUTH=api_key. With BEDROCK_AUTH=iam leave it empty and supply AWS credentials
# from the secret manager as the AWS SDK expects them (AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY of a
# least-privilege IAM user, or a role); they are read by the SDK, not listed in this template.
BEDROCK_API_KEY=
# SECRET: random, at least 24 characters (openssl rand -hex 24); only your metrics scraper knows it
METRICS_TOKEN=
# SECRET: random, at least 32 characters (openssl rand -hex 32); a DIFFERENT value from METRICS_TOKEN.
# Only operators get it: it opens GET /v1/providers (internal provider configuration).
OPERATOR_TOKEN=

# --- DASH Intelligence Router -----------------------------------------------------------------
# Optional JSON merged over the default routing policy (provider capabilities, context sizes,
# relative costs, quality per route, task weights, circuit breaker). Empty = defaults.
# See docs/intelligence-router.md. Example: {"circuit":{"failureThreshold":5}}
ROUTER_POLICY=

# --- DASH Automates (server-side scheduled tasks) ---------------------------------------------
# false stops the scheduler on this instance and refuses new runs (automations are kept).
AUTOMATIONS_ENABLED=true
# How often each instance looks for due automations and queued runs (ms), how many runs one
# instance executes at once, and how many automations one account may keep.
AUTOMATIONS_TICK_MS=15000
AUTOMATIONS_CONCURRENCY=2
AUTOMATIONS_MAX_PER_USER=25

# --- Push notifications (DASH Automates) ---------------------------------------------------------
# Staging starts without pushes. To deliver them to the Android app: PUSH_TRANSPORT=fcm and
# FCM_SERVICE_ACCOUNT from the secret manager (docs/push-notifications.md). Never commit the key.
PUSH_TRANSPORT=none
FCM_SERVICE_ACCOUNT=
PUSH_TICK_MS=5000
PUSH_MAX_ATTEMPTS=5
PUSH_RETRY_BASE_MS=30000
PUSH_TTL_SECONDS=86400
