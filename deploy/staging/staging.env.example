# Dash AI API — STAGING configuration template.
#
# This file is safe to commit: it contains no secrets and no real hostnames. Copy the
# non-secret values into your platform's environment settings. The five secrets marked
# SECRET below must come from a secret manager and must never be written into this file,
# a commit, a ticket or a chat. See docs/staging-runbook.md.

# --- Values safe to commit (staging defaults) -----------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Real providers. Each needs BOTH its key (secret) and its model id.
PROVIDER_MODE=live
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Leave false until the live smoke test passes for your OpenAI model.
OPENAI_ENCRYPTED_REASONING=false

PROVIDER_TIMEOUT_MS=120000
PROVIDER_IDLE_TIMEOUT_MS=45000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
MAX_OUTPUT_TOKENS=16000
FAKE_STREAM_DELAY_MS=25
DOCUMENT_EXTRACTION_TIMEOUT_MS=20000

RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_SYNC_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_ACCOUNT=20
MAX_CONCURRENT_STREAMS_PER_USER=3
# Shared limits across instances (required with more than one API instance).
RATE_LIMIT_BACKEND=redis

SESSION_TTL_DAYS=30
# The API runs behind an HTTPS reverse proxy / load balancer that sets X-Forwarded-For.
TRUST_PROXY=true

# PostgreSQL over verified TLS. Migrations are a deliberate deployment step.
DATABASE_SSL=require
DATABASE_POOL_MAX=10
DATABASE_AUTO_MIGRATE=false
DATA_ENCRYPTION_KEY_ID=k1
ALLOW_MEMORY_STORE=false

TOOLS_ENABLED=true
TOOL_TIMEOUT_MS=10000
TOOL_MAX_ROUNDS=4
TOOL_MAX_RESULT_CHARS=20000

# --- SECRETS: set in the secret manager, never here ------------------------------------------
# SECRET: postgres://USER:PASSWORD@HOST:5432/DB (TLS is enforced by DATABASE_SSL=require)
DATABASE_URL=
# SECRET: base64 of 32 random bytes: openssl rand -base64 32. Back it up separately.
DATA_ENCRYPTION_KEY=
# SECRET (only after a key rotation): old_id:base64,...
DATA_ENCRYPTION_PREVIOUS_KEYS=
# SECRET: rediss://:PASSWORD@HOST:6380 (TLS) for the shared rate limiter
REDIS_URL=
# SECRET: provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SECRET: random, at least 24 characters (openssl rand -hex 24); only your metrics scraper knows it
METRICS_TOKEN=
