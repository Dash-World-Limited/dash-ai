{
  "name": "dash-ai",
  "private": true,
  "description": "Dash AI \u2014 Dash World's multi-model AI assistant (Android app + secure API).",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter @dash-ai/contracts --filter @dash-ai/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @dash-ai/contracts build && pnpm -r typecheck",
    "test": "pnpm --filter @dash-ai/contracts build && pnpm -r test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "check": "pnpm scan:secrets && pnpm lint && pnpm typecheck && pnpm test",
    "smoke:live": "pnpm --filter @dash-ai/api smoke:live"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
