<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DashAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dash_black</item>
    </style>

    <!-- System splash (Android 12+ API, backported by core-splashscreen). -->
    <style name="Theme.DashAI.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dash_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.DashAI</item>
    </style>
</resources>
