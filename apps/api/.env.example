# Dash AI API — example configuration.
# Copy to apps/api/.env and fill in locally. NEVER commit a real .env file or real keys.
# Every value below is a placeholder.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# live = call real providers whose required settings are complete.
# fake = use the built-in demonstration adapters (no network, no cost, clearly labelled as demos).
# With NODE_ENV=production, live refuses to start unless at least one provider below is complete,
# none is half-configured, and no key looks like a placeholder.
PROVIDER_MODE=fake

# hidden = consumer responses never name the AI provider or model (production default; DASH AI is
# the product). exposed = engineering/diagnostic mode for local debugging and smoke runs only.
PROVIDER_DETAILS=hidden

# OpenAI (Responses API). Set the model to a current model id from OpenAI's documentation.
OPENAI_API_KEY=
OPENAI_MODEL=
# Reasoning models only: request and replay encrypted reasoning between tool rounds (store stays false).
# Leave false until verified with `DASH_LIVE_SMOKE=1 pnpm smoke:live` for your model.
OPENAI_ENCRYPTED_REASONING=false

# Anthropic Claude (Messages API). Set the model to a current model id from Anthropic's documentation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Amazon Bedrock (native Converse API). All values are server-only. BEDROCK_API_KEY is a secret.
# Production should use short-lived Bedrock credentials/keys where possible. Configure at least one
# Nova tier; DASH chooses between configured tiers inside the Bedrock adapter.
BEDROCK_API_KEY=
BEDROCK_REGION=
BEDROCK_MODEL_MICRO=
BEDROCK_MODEL_LITE=
BEDROCK_MODEL_NOVA2_LITE=

# Timeouts and output limits
PROVIDER_TIMEOUT_MS=120000
PROVIDER_IDLE_TIMEOUT_MS=45000
# Retryable provider failures that happen before any output are retried this many times, with
# exponential backoff from this base delay. 0 disables retries.
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_MS=500
# Per answer. Includes reasoning/thinking tokens on models that think, so leave room for both.
MAX_OUTPUT_TOKENS=16000
FAKE_STREAM_DELAY_MS=25
# PDF and DOCX files are parsed in a separate, memory-limited process; this is its time limit.
DOCUMENT_EXTRACTION_TIMEOUT_MS=20000

# Abuse protection (requests per minute)
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_SYNC_PER_MINUTE=60
# Sign-in attempts per account (email) per 15 minutes, across all IPs.
RATE_LIMIT_LOGIN_PER_ACCOUNT=20
# memory = limits per API process (one instance, development). redis = shared by all instances;
# required when more than one API instance runs. REDIS_URL is a secret (it usually contains a
# password): set it in your secret manager, never here. Use rediss:// for TLS.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
MAX_CONCURRENT_STREAMS_PER_USER=3

SESSION_TTL_DAYS=30
# Only set to true behind a trusted reverse proxy.
TRUST_PROXY=false

# --- Persistence (PostgreSQL) ---------------------------------------------------------------
# Leave DATABASE_URL empty to use the in-memory store (development/tests only: data is lost on
# restart, and production refuses to start without a database). Set it locally, never commit it.
DATABASE_URL=
# disable | require | no-verify. Defaults to "require" in production, "disable" otherwise.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# Apply pending migrations at startup (default: true outside production, false in production,
# where you run `pnpm --filter @dash-ai/api migrate` as a deliberate deployment step).
DATABASE_AUTO_MIGRATE=
# Required with DATABASE_URL. Encrypts conversation titles, message content and extracted
# document text at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32   — keep it in a secret manager and back it up:
# losing it makes stored conversations and document text unreadable.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# Retired keys still needed to read old data after a rotation: id:base64,id2:base64
DATA_ENCRYPTION_PREVIOUS_KEYS=
# --- Operations ---------------------------------------------------------------------------
# Bearer token (at least 24 characters) for GET /metrics. Empty = no metrics endpoint. Secret.
METRICS_TOKEN=
# Bearer token (at least 32 characters) for the operator view GET /v1/providers. Must differ from
# METRICS_TOKEN. Empty = no operator access while provider details are hidden. Secret.
OPERATOR_TOKEN=

# Production refuses to start without DATABASE_URL unless this is true (throwaway demos only).
ALLOW_MEMORY_STORE=false

# --- Tool calling ----------------------------------------------------------------------------
# Server-wide kill switch: false offers no tools to any model, whatever users enabled.
TOOLS_ENABLED=true
# Per tool call (hard ceiling 120000), model/tool rounds per answer, and characters of tool output
# returned to the model.
TOOL_TIMEOUT_MS=10000
TOOL_MAX_ROUNDS=4
TOOL_MAX_RESULT_CHARS=20000

# --- DASH Intelligence Router -----------------------------------------------------------------
# Optional JSON merged over the default routing policy (provider capabilities, context sizes,
# relative costs, quality per route, task weights, circuit breaker). Empty = defaults.
# See docs/intelligence-router.md. Example: {"circuit":{"failureThreshold":5}}
ROUTER_POLICY=

# --- DASH Automates (server-side scheduled tasks) ---------------------------------------------
# false stops the scheduler on this instance and refuses new runs (automations are kept).
AUTOMATIONS_ENABLED=true
# How often each instance looks for due automations and queued runs (ms), how many runs one
# instance executes at once, and how many automations one account may keep.
AUTOMATIONS_TICK_MS=15000
AUTOMATIONS_CONCURRENCY=2
AUTOMATIONS_MAX_PER_USER=25

# --- Push notifications (DASH Automates) -------------------------------------------------------
# none: no pushes (results and in-app notices still work). fcm: Android via Firebase Cloud Messaging.
# fake: recorded, never sent (local development). See docs/push-notifications.md.
PUSH_TRANSPORT=none
# Firebase service-account JSON key (raw JSON or base64) allowed to send FCM messages. Secret: keep it
# in a secret manager, never in the repository. Required when PUSH_TRANSPORT=fcm.
FCM_SERVICE_ACCOUNT=
# How often each instance looks for due pushes (ms), attempts per device before giving up, the first
# retry delay (ms, doubling with jitter, capped at an hour), and how long a push may wait (seconds).
PUSH_TICK_MS=5000
PUSH_MAX_ATTEMPTS=5
PUSH_RETRY_BASE_MS=30000
PUSH_TTL_SECONDS=86400